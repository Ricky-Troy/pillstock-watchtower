{
  "version": 1,
  "sdk_version": "3.5.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://cskldrvnpxmiajrmajtk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "pillstock-watchtower",
      "version": "0.1.0",
      "title": "Pillstock Watchtower"
    },
    "tools": [
      {
        "name": "list_medicines",
        "title": "List medicines",
        "description": "List active medicines with current stock, minimum level, unit price (KES) and stock status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "maxLength": 100,
              "description": "Match medicine name, generic name or category."
            },
            "status": {
              "type": "string",
              "enum": [
                "all",
                "ok",
                "low",
                "out"
              ],
              "description": "Filter by stock status. Defaults to all."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Maximum medicines to return (default 100)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_stock_alerts",
        "title": "List stock alerts",
        "description": "List low-stock and out-of-stock alerts, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "RESOLVED"
              ],
              "description": "Alert status to show. Defaults to ACTIVE."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Maximum alerts to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "List stock transactions",
        "description": "List recent stock-in, sale (stock-out) and audit adjustment transactions, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "IN",
                "OUT",
                "ADJUST"
              ],
              "description": "Only this transaction type. Omit for all."
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 366,
              "description": "Only transactions from the last N days (default 30)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "description": "Maximum transactions to return (default 50)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "monthly_stock_report",
        "title": "Monthly stock report",
        "description": "Per-medicine received, issued and sales value (KES) for one month. Administrators and pharmacists only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "description": "Month as YYYY-MM, e.g. 2026-11."
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Only this medicine category."
            }
          },
          "required": [
            "month"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
